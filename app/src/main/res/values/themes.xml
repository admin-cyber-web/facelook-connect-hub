<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Stable AppCompat theme used by the WebView activity. -->
    <style name="Theme.FlicksIndia" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <!-- Disable native system preview window to eliminate startup white flash -->
        <item name="android:windowDisablePreview">true</item>
        <!-- Match native window background with dark theme #0F172A -->
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:colorBackground">#0F172A</item>
    </style>
</resources>
